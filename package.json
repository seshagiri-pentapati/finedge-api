{
    "name":  "finedge-api",
    "version":  "1.0.0",
    "description":  "Personal Finance \u0026 Expense Tracker API",
    "main":  "src/app.js",
    "type":  "module",
    "scripts":  {
                    "start":  "node src/app.js",
                    "dev":  "nodemon src/app.js",
                    "test":  "node --experimental-vm-modules node_modules/jest/bin/jest.js",
                    "format":  "prettier --write \"**/*.{js,json}\"",
                    "lint":  "eslint \"**/*.js\""
                },
    "keywords":  [
                     "finance",
                     "expense",
                     "tracker",
                     "api"
                 ],
    "author":  "",
    "license":  "ISC",
    "dependencies":  {
                         "express":  "^4.18.2",
                         "dotenv":  "^16.0.3",
                         "jsonwebtoken":  "^9.0.0",
                         "bcryptjs":  "^2.4.3"
                     },
    "devDependencies":  {
                            "nodemon":  "^2.0.20",
                            "jest":  "^29.0.0",
                            "eslint":  "^8.56.0",
                            "prettier":  "^3.2.0",
                            "eslint-config-prettier":  "^9.1.0"
                        },
    "prettier":  {
                     "semi":  false,
                     "trailingComma":  "all"
                 }
}